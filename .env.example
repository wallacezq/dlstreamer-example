# Environment variables for DL Streamer pipeline
# Copy to .env and modify as needed

# RTSP input stream URL
RTSP_INPUT=rtsp://localhost:8554/stream

# UDP output destination
OUTPUT_HOST=224.1.1.1
OUTPUT_PORT=5000

# Inference device: CPU, GPU, or NPU
# NPU requires Intel Core Ultra (Meteor Lake+) with NPU driver installed
DEVICE=CPU

# Tracker type: short-term, short-term-imageless, zero-term, zero-term-imageless
TRACKER_TYPE=short-term-imageless
